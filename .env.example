# Copia este archivo a `.env` y completa los valores de tu proyecto Supabase.
# Puedes obtenerlos en: Project Settings -> API.

PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<clave-publica>

# URL pública para enlaces de confirmación y recuperación (HTTPS en producción).
# En local puedes omitirla y se usará el origen de la petición.
# SITE_URL=https://tu-dominio.com

# Notificaciones push (Web Push). Genera el par con: npx web-push generate-vapid-keys
# Sin estas claves la app funciona igual, pero Ajustes muestra el push como no configurado.
# PUBLIC_VAPID_PUBLIC_KEY=BF...   (base64url, también viaja al navegador)
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:tu@correo.com

# Secreto del cron de notificaciones (mínimo 16 caracteres). Va en la cabecera
# `x-cron-secret` al llamar a /api/cron/notifications.
# CRON_SECRET=...

# Solo servidor: la usa el cron para reclamar avisos sin sesión de usuario.
# Project Settings -> API -> service_role. Nunca la expongas al cliente.
# SUPABASE_SERVICE_ROLE_KEY=...

# Credenciales de un usuario de pruebas dedicado para Playwright (no las subas al repo).
# E2E_EMAIL=test@tu-dominio.com
# E2E_PASSWORD=...
